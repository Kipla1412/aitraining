# Copy this file to ".env" and fill in your real values.

# Required: your OpenAI API key
OPENAI_KEY=sk-your-key-here

# Optional: override the API base URL (for OpenAI-compatible endpoints)
# OPENAI_BASE_URL=https://api.openai.com/v1

# Optional: model name (default: gpt-4o-mini)
# OPENAI_MODEL=gpt-4o-mini

# --- Gemini (only needed if you use -p gemini / LLM_PROVIDER=gemini) ---
# GEMINI_API_KEY=your-gemini-key
# GEMINI_MODEL=gemini-3.6-flash

# Optional: default provider when using ClientFactory.create_default()
# LLM_PROVIDER=openai
